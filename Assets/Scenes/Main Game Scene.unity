MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 985888950}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9252e4e3190118945b8c386b096b1146, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  jsonFileName: TasksJson
  missionSpawnPoints: {fileID: 314931580}
  hintButton: {fileID: 8509624275611239881}
  showHintButton: {fileID: 6626355165444107624}
  objectiveText: {fileID: 2308413598067220328}
  survivalTime: 120
  tasks:
  - taskName: Break the Chain
    description: The mansion gate is locked with a heavy chain. Find an axe or hammer
      and break it to enter.
    hint: Search near the tool shed or behind the crates.
    taskSpawnPoint: {fileID: 1911088528}
    interactableToComplete: {fileID: 6471652502616847142}
  - taskName: Find the Key
    description: Enter the Mansiom. Find for a key to open door lock. Using Hammer
      will alert the granny
    hint: "Among the graves lies a key\u2026 shaped like key."
    taskSpawnPoint: {fileID: 1271091704}
    interactableToComplete: {fileID: 163239024}
  - taskName: Restore the Power
    description: Find a flashlight, enter the basement, and turn on the generator
      to restore the lights.
    hint: Flashlight may be near the dining table. Look for the generator lever in
      the basement corner.
    taskSpawnPoint: {fileID: 1014294342}
    interactableToComplete: {fileID: 1592212656}
  - taskName: Recover Broken Photograph
    description: Go inside hidden room and Retrieve Broken family photo
    hint: Look for a key near the dining area. Once inside the locked room, investigate
      the furniture closely.
    taskSpawnPoint: {fileID: 1014294342}
    interactableToComplete: {fileID: 1832006979}
  - taskName: Calm the Ghost
    description: Find the toys and bring back to her.
    hint: Search where the girl used to eat, the place where she took her final breath,
      and where she spent her nights.
    taskSpawnPoint: {fileID: 2072523844}
    interactableToComplete: {fileID: 417530888}
  - taskName: Retrieve Ritual Book
    description: The Ritual Book is hidden in the attic, guarded by mannequins that
      move when you're not looking.
    hint: Keep your eyes on the mannequins. The book is on a central table.
    taskSpawnPoint: {fileID: 2147288268}
    interactableToComplete: {fileID: 1489035484}
  - taskName: Collect Cursed Objects
    description: 'To break the curse, gather 4 cursed objects: Granny''s locket,
      granddaughter''s ribbon, blood-stained needle, music box.'
    hint: Each item is protected by traps or sudden scares. Move slowly.
    taskSpawnPoint: {fileID: 881471730}
    interactableToComplete: {fileID: 707821939585889354}
  currentTaskIndex: 0
  isGameStarted: 0
  isInSurvivalMode: 0
